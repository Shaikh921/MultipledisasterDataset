# AAPADAMITRA API Environment Variables Template
# Copy this file to .env for local development

# 1. Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# 2. Security (API Key Header: X-API-Key)
API_KEY=aapadamitra-dev-key

# 3. Model Storage (Local Repository Checkout)
MODEL_DIR=models/training/cyclone/artifacts

# 4. Operational Constraints (Render Free Tier limit: 512 MB)
MAX_MEMORY_RSS_MB=512.0
